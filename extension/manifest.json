{
  "manifest_version": 3,
  "name": "Pengecek Jumlah Bidang ATR/BPN",
  "version": "1.2.0",
  "description": "Menghubungkan Aplikasi Daftar Nominatif dengan halaman Informasi Berkas ATR/BPN.",
  "permissions": ["tabs", "notifications"],
  "host_permissions": ["https://aplikasi.atrbpn.go.id/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["file:///*", "http://localhost/*", "https://aplikasi.atrbpn.go.id/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Pengecek Jumlah Bidang",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  }
}
